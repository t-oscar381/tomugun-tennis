# Shares the Supabase project with celebration.tomugun.com — every table in
# this app is prefixed `tennis_`. See supabase/schema.sql.
SUPABASE_URL=https://kufmpppkpmjcmsyeztdm.supabase.co

# service_role — bypasses RLS. Server-only, never NEXT_PUBLIC_, never committed.
# Copy from the wedding project's .env.local, or Supabase dashboard >
# Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# The league this deployment serves. Matches a slug in tennis_groups.
GROUP_SLUG=jakarta

SITE_URL=http://localhost:3220
