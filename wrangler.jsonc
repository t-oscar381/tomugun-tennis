{
  "$schema": "node_modules/wrangler/config-schema.json",

  // One repo, one Worker, one subdomain — same rule as tomugun-celebration.
  // Name tracks the GitHub repo (tomugun-tennis); the custom domain is set
  // separately in the dashboard and is play-tennis.tomugun.com.
  "name": "tomugun-tennis",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  // nodejs_compat: OpenNext's adapter and its dependencies expect Node globals
  // and process.env access.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Non-secret runtime vars, committed on purpose. `wrangler deploy` wipes any
  // plain variable set in the dashboard that isn't declared here, on EVERY
  // deploy — Cloudflare documents this as intended. Keeping them here means
  // they survive. SUPABASE_SERVICE_ROLE_KEY stays out of this file and out of
  // git: set it as a Secret (not a Variable) in the dashboard, because deploys
  // never touch secrets.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://kufmpppkpmjcmsyeztdm.supabase.co",
    "NEXT_PUBLIC_GROUP_SLUG": "jakarta",
    "SITE_URL": "https://play-tennis.tomugun.com"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Self-reference for OpenNext's internal revalidation plumbing. Must match
  // "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tomugun-tennis"
    }
  ]
}
