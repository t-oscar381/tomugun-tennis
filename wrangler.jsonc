{
  "$schema": "node_modules/wrangler/config-schema.json",

  // One repo, one Worker, one subdomain — same rule as tomugun-celebration.
  // Name tracks the GitHub repo (tomugun-tennis); the custom domain is set
  // separately in the dashboard and is play-tennis.tomugun.com.
  "name": "tomugun-tennis",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  // nodejs_compat: OpenNext's adapter and its dependencies expect Node globals
  // and process.env access.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Non-secret runtime vars, committed on purpose. THIS FILE IS THE SOURCE OF
  // TRUTH for them: `wrangler deploy` wipes any plain variable set in the
  // dashboard that isn't declared here, on EVERY deploy — Cloudflare documents
  // this as intended. Editing these in the dashboard is therefore pointless;
  // edit them here.
  //
  // None of these carry a NEXT_PUBLIC_ prefix on purpose. Next inlines those
  // into the bundle at build time, which would freeze them to whatever the
  // build machine had and make the values below dead weight. See src/lib/db.ts.
  //
  // SUPABASE_SERVICE_ROLE_KEY stays out of this file and out of git: set it as
  // a Secret (not a Variable) in the dashboard. Deploys never touch secrets,
  // and Secrets take precedence over anything baked into the bundle.
  "vars": {
    "SUPABASE_URL": "https://kufmpppkpmjcmsyeztdm.supabase.co",
    "GROUP_SLUG": "jakarta",
    "SITE_URL": "https://play-tennis.tomugun.com"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Self-reference for OpenNext's internal revalidation plumbing. Must match
  // "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tomugun-tennis"
    }
  ]
}
